{
  "name": "bayloob",
  "version": "0.13.1",
  "author": {
    "name": "Baynovix",
    "email": "info@baynovix.com"
  },
  "main": "out/main/index.js",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@shadcn/react": "0.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "5.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "electron-vite": "5.0.0",
    "jsdom": "30.1.2",
    "lucide-react": "1.55.0",
    "radix-ui": "1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "7.3.7",
    "vitest": "5.0.4",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "build": {
    "appId": "com.baynovix.bayloob",
    "productName": "Bayloob",
    "executableName": "bayloob",
    "files": ["out/**/*", "src/**/*", "!src/main/**", "!src/preload/**", "package.json"],
    "extraResources": [
      {
        "from": "resources/hooks",
        "to": "hooks"
      },
      {
        "from": "resources/tools",
        "to": "tools"
      },
      {
        "from": "gnome-extension",
        "to": "gnome-extension"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "target": ["deb"],
      "category": "Development",
      "icon": "build/icon.png",
      "synopsis": "Status overlay for AI coding agents",
      "maintainer": "Baynovix <info@baynovix.com>"
    },
    "deb": {
      "packageName": "bayloob",
      "compression": "xz",
      "afterInstall": "build/after-install.sh",
      "afterRemove": "build/after-remove.sh",
      "recommends": ["tmux"]
    },
    "publish": null
  },
  "description": "A local status overlay for AI coding agents (Claude Code, Codex, Gemini CLI)",
  "homepage": "https://baynovix.com",
  "license": "MIT",
  "packageManager": "bun@1.4.0",
  "productName": "Bayloob",
  "scripts": {
    "start": "electron-vite preview --noSandbox",
    "dev": "electron-vite dev --noSandbox --watch",
    "workspace": "electron-vite dev --noSandbox --watch -- --workspace",
    "demo": "electron-vite dev --noSandbox -- --demo",
    "build": "electron-vite build",
    "install-hooks": "bun scripts/install-hooks.js",
    "test-events": "bun scripts/simulate.js",
    "dist:deb": "electron-vite build && electron-builder --linux deb",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "node --test test/*.test.js && vitest run",
    "test:main": "node --test test/*.test.js",
    "test:ui": "vitest run",
    "test:e2e": "electron-vite build && playwright test"
  },
  "trustedDependencies": ["electron"]
}
