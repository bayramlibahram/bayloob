{
  "name": "bayloob",
  "productName": "Bayloob",
  "version": "0.8.0",
  "description": "A local status overlay for AI coding agents (Claude Code, Codex, Gemini CLI)",
  "homepage": "https://baynovix.com",
  "author": {
    "name": "Baynovix",
    "email": "info@baynovix.com"
  },
  "license": "MIT",
  "main": "src/main/index.js",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --no-sandbox",
    "demo": "electron . --no-sandbox --demo",
    "install-hooks": "bun scripts/install-hooks.js",
    "test-events": "bun scripts/simulate.js",
    "dist:deb": "electron-builder --linux deb",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "trustedDependencies": ["electron"],
  "build": {
    "appId": "com.baynovix.bayloob",
    "productName": "Bayloob",
    "executableName": "bayloob",
    "files": ["src/**/*", "package.json"],
    "extraResources": [
      {
        "from": "resources/hooks",
        "to": "hooks"
      },
      {
        "from": "resources/tools",
        "to": "tools"
      },
      {
        "from": "gnome-extension",
        "to": "gnome-extension"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "target": ["deb"],
      "category": "Development",
      "icon": "build/icon.png",
      "synopsis": "Status overlay for AI coding agents",
      "maintainer": "Baynovix <info@baynovix.com>"
    },
    "deb": {
      "packageName": "bayloob",
      "compression": "xz",
      "afterInstall": "build/after-install.sh",
      "afterRemove": "build/after-remove.sh",
      "recommends": ["tmux"]
    },
    "publish": null
  }
}
