#!/usr/bin/env bash
# Bayloob hook — no dependencies (no node, no curl), just bash /dev/tcp.
# Claude Code / Gemini pass the event JSON on stdin.   Codex passes it as the last argument.
# Usage: bayloob-hook <agent> [json]
agent="${1:-claude}"
port="${BAYLOOB_PORT:-7777}"

if [ -n "$2" ]; then body="$2"; else body="$(cat)"; fi   # read stdin first, so the agent never gets EPIPE
[ -z "$body" ] && exit 0

# The shared secret written by Bayloob (mode 0600); no file → Bayloob never ran, nothing to tell
token_file="${BAYLOOB_TOKEN_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/Bayloob/token}"
token="$(head -c 64 "$token_file" 2>/dev/null)"
[ ${#token} -eq 64 ] || exit 0

# If Bayloob isn't running the connection fails immediately — we never block the agent
{ exec 3<>"/dev/tcp/127.0.0.1/$port"; } 2>/dev/null || exit 0

enc() { printf '%s' "$1" | od -An -tx1 | tr -d ' \n' | sed 's/../%&/g'; }

# For "Open terminal": fingerprints of the terminal this hook is running in
q="agent=$(enc "$agent")&cwd=$(enc "$PWD")&pid=$PPID"
q+="&term=$(enc "${TERM_PROGRAM:-}")&winid=$(enc "${WINDOWID:-}")"
q+="&kitty=$(enc "${KITTY_WINDOW_ID:-}")&kittysock=$(enc "${KITTY_LISTEN_ON:-}")"
q+="&wez=$(enc "${WEZTERM_PANE:-}")&tmux=$(enc "${TMUX_PANE:-}")"

path="/ev"
# Permission request: wait for the user's answer in Bayloob and hand the decision back to the agent
if [[ $body =~ \"hook_event_name\"[[:space:]]*:[[:space:]]*\"PermissionRequest\" ]]; then path="/perm"; fi
# A prompt (Claude Code): Bayloob may answer with the owner's response format as hidden context
wait=""
if [[ $body =~ \"hook_event_name\"[[:space:]]*:[[:space:]]*\"UserPromptSubmit\" ]]; then wait=1; fi
# A question from the agent: wait for the answer picked in Bayloob (PreToolUse can carry the answers)
if [[ $body =~ \"hook_event_name\"[[:space:]]*:[[:space:]]*\"PreToolUse\" && $body =~ \"tool_name\"[[:space:]]*:[[:space:]]*\"AskUserQuestion\" ]]; then path="/perm"; fi

len="$(LC_ALL=C; printf '%s' "${#body}")"   # byte length, not character length
printf 'POST %s?%s HTTP/1.0\r\nHost: 127.0.0.1:%s\r\nX-Bayloob-Token: %s\r\nContent-Type: application/json\r\nContent-Length: %s\r\n\r\n%s' \
  "$path" "$q" "$port" "$token" "$len" "$body" >&3

if [ "$path" = "/perm" ]; then
  resp="$(cat <&3)"                     # blocks until the server replies and closes
  out="${resp#*$'\r\n\r\n'}"
  [ -n "$out" ] && printf '%s' "$out"   # empty → the agent shows its normal terminal prompt
elif [ -n "$wait" ]; then
  resp="$(timeout 2 cat <&3 2>/dev/null)"
  out="${resp#*$'\r\n\r\n'}"
  [[ $out == "{"* ]] && printf '%s' "$out"   # only JSON (an older Bayloob answers "ok")
else
  read -r -t 1 -u 3 _ 2>/dev/null
fi
exec 3>&-
exit 0
